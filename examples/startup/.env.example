# Local development only. Run setup.sh to generate the three secrets.
APP_NAME=startup
APP_ENV=development
APP_PORT=3300
METRICS_PORT=9300
APP_FRONTEND_URL=http://localhost:5174
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55435
DB_NAME=startup
DB_USER=postgres
DB_PASSWORD=startup-local
DATABASE_SSL_MODE=disable
DB_AUTO_MIGRATE=true
REDIS_MODE=required
REDIS_HOST=127.0.0.1
REDIS_PORT=56380
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:55673/
RABBITMQ_EXCHANGE=startup
RABBITMQ_QUEUE_PREFIX=startup
JWT_ISSUER=startup
SMTP_HOST=127.0.0.1
SMTP_PORT=51026
SMTP_FROM_EMAIL=noreply@startup.local
SMTP_FROM_NAME=Startup
CORS_ALLOWED_ORIGINS=http://localhost:5174
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
OTEL_TRACES_ENABLED=false
OTEL_METRICS_ENABLED=false
